// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique @db.VarChar(255)
  passwordHash    String?  @map("password_hash") @db.VarChar(255)
  nickname        String   @unique @db.VarChar(50)
  profileImageUrl String?  @map("profile_image_url") @db.Text
  kakaoId         String?  @unique @map("kakao_id") @db.VarChar(100)
  provider        String   @default("local") @db.VarChar(20)
  isDeleted       Boolean  @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  activityScore   Int      @default(0) @map("activity_score")
  createdAt       DateTime @default(now()) @map("created_at")

  groupMembers GroupMember[]
  memos        Memo[]
  discussions  Discussion[]
  comments     Comment[]
  replies      Reply[]
  ownedGroups  Group[]      @relation("GroupOwner")
  bans         GroupBan[]
  tokens       DiscussionToken[]
  insights     DiscussionInsight[]
  notifications Notification[]
  reports      Report[]

  @@map("users")
}

model Book {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(255)
  author        String?  @db.VarChar(255)
  coverImageUrl String?  @map("cover_image_url") @db.Text
  summary       String?  @db.Text
  isbn          String?  @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  groups Group[]

  @@map("books")
}

model Group {
  id               String   @id @default(uuid())
  bookId           String   @map("book_id")
  ownerId          String   @map("owner_id")
  name             String   @db.VarChar(100)
  description      String?  @db.Text
  maxMembers       Int      @map("max_members")
  readingStartDate DateTime @map("reading_start_date") @db.Date
  readingEndDate   DateTime @map("reading_end_date") @db.Date
  discussionDate   DateTime? @map("discussion_date") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")

  isPrivate           Boolean   @default(false) @map("is_private")
  password            String?   @map("password") @db.VarChar(255)
  inviteCode          String?   @unique @map("invite_code") @db.VarChar(20)
  inviteCodeExpiresAt DateTime? @map("invite_code_expires_at")

  book          Book           @relation(fields: [bookId], references: [id], map: "buzzy_pages_groups_book_id_fkey")
  owner         User           @relation("GroupOwner", fields: [ownerId], references: [id], map: "buzzy_pages_groups_owner_id_fkey")
  members       GroupMember[]
  memos         Memo[]
  discussions   Discussion[]
  announcements Announcement[]
  bans          GroupBan[]
  schedules     DiscussionSchedule[]
  insights      DiscussionInsight[]
  tags          GroupTag[]
  notifications Notification[]

  @@map("groups")
}

model GroupTag {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  name      String   @db.VarChar(15)
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade, map: "buzzy_pages_group_tags_group_id_fkey")

  @@index([groupId])
  @@index([name])
  @@map("group_tags")
}

model GroupMember {
  id              String   @id @default(uuid())
  groupId         String   @map("group_id")
  userId          String   @map("user_id")
  readingProgress Int      @default(0) @map("reading_progress")
  role            String   @default("member") @db.VarChar(20)
  joinedAt        DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], map: "buzzy_pages_group_members_group_id_fkey")
  user  User  @relation(fields: [userId], references: [id], map: "buzzy_pages_group_members_user_id_fkey")

  @@unique([groupId, userId])
  @@map("group_members")
}

model Memo {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  pageStart Int      @map("page_start")
  pageEnd   Int      @map("page_end")
  content   String   @db.Text
  imageUrl  String?  @map("image_url") @db.Text
  isPublic   Boolean  @default(false) @map("is_public")
  visibility String   @default("private") @map("visibility") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  group       Group        @relation(fields: [groupId], references: [id], map: "buzzy_pages_memos_group_id_fkey")
  user        User         @relation(fields: [userId], references: [id], map: "buzzy_pages_memos_user_id_fkey")
  discussions Discussion[]

  @@map("memos")
}

model Discussion {
  id            String    @id @default(uuid())
  groupId       String    @map("group_id")
  authorId      String    @map("author_id")
  memoId        String?   @map("memo_id")
  title         String    @db.VarChar(200)
  content       String?   @db.Text
  bookTitle     String?   @map("book_title") @db.VarChar(255)
  imageUrl      String?   @map("image_url") @db.Text
  isRecommended Boolean   @default(false) @map("is_recommended")
  isPinned      Boolean   @default(false) @map("is_pinned")
  status        String    @default("active") @map("status") @db.VarChar(20)
  endDate       DateTime? @map("end_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  group    Group              @relation(fields: [groupId], references: [id], map: "buzzy_pages_discussions_group_id_fkey")
  author   User               @relation(fields: [authorId], references: [id], map: "buzzy_pages_discussions_author_id_fkey")
  memo     Memo?              @relation(fields: [memoId], references: [id], map: "buzzy_pages_discussions_memo_id_fkey")
  comments Comment[]
  tokens   DiscussionToken[]
  notifications Notification[]

  @@map("discussions")
}

model DiscussionToken {
  id           String   @id @default(uuid())
  discussionId String   @map("discussion_id")
  userId       String   @map("user_id")
  remaining    Int      @default(10)
  requested    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  discussion Discussion @relation(fields: [discussionId], references: [id], map: "buzzy_pages_discussion_tokens_discussion_id_fkey")
  user       User       @relation(fields: [userId], references: [id], map: "buzzy_pages_discussion_tokens_user_id_fkey")

  @@unique([discussionId, userId])
  @@map("discussion_tokens")
}

model Comment {
  id           String   @id @default(uuid())
  discussionId String   @map("discussion_id")
  authorId     String   @map("author_id")
  content      String   @db.Text
  imageUrl      String?  @map("image_url") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  discussion Discussion @relation(fields: [discussionId], references: [id], map: "buzzy_pages_comments_discussion_id_fkey")
  author     User       @relation(fields: [authorId], references: [id], map: "buzzy_pages_comments_author_id_fkey")
  replies    Reply[]

  @@map("comments")
}

model Reply {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  authorId  String   @map("author_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], map: "buzzy_pages_replies_comment_id_fkey")
  author  User    @relation(fields: [authorId], references: [id], map: "buzzy_pages_replies_author_id_fkey")

  @@map("replies")
}

model Announcement {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  authorId  String   @map("author_id")
  title     String   @db.VarChar(200)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  group  Group @relation(fields: [groupId], references: [id], map: "buzzy_pages_announcements_group_id_fkey")
  notifications Notification[]

  @@map("announcements")
}

model Notification {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  groupId        String   @map("group_id")
  discussionId   String?  @map("discussion_id")
  announcementId String?  @map("announcement_id")
  type           String   @db.VarChar(50)
  message        String   @db.VarChar(500)
  linkUrl        String   @map("link_url") @db.VarChar(255)
  dedupeKey      String   @map("dedupe_key") @db.VarChar(120)
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "buzzy_pages_notifications_user_id_fkey")
  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade, map: "buzzy_pages_notifications_group_id_fkey")
  discussion   Discussion?   @relation(fields: [discussionId], references: [id], onDelete: Cascade, map: "buzzy_pages_notifications_discussion_id_fkey")
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade, map: "buzzy_pages_notifications_announcement_id_fkey")

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
  @@index([groupId])
  @@map("notifications")
}

model GroupBan {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], map: "buzzy_pages_group_bans_group_id_fkey")
  user  User  @relation(fields: [userId], references: [id], map: "buzzy_pages_group_bans_user_id_fkey")

  @@unique([groupId, userId])
  @@map("group_bans")
}

model DiscussionSchedule {
  id          String   @id @default(uuid())
  groupId     String   @map("group_id")
  title       String   @db.VarChar(200)
  description String?  @db.Text
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], map: "buzzy_pages_discussion_schedules_group_id_fkey")

  @@map("discussion_schedules")
}

model DiscussionInsight {
  id              String   @id @default(uuid())
  groupId         String   @map("group_id")
  userId          String   @map("user_id")
  summary         String   @db.Text
  keywords        String   @db.Text
  participantStats String  @map("participant_stats") @db.Text
  memoCount       Int      @default(0) @map("memo_count")
  discussionCount Int      @default(0) @map("discussion_count")
  commentCount    Int      @default(0) @map("comment_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  group Group @relation(fields: [groupId], references: [id], map: "buzzy_pages_discussion_insights_group_id_fkey")
  user  User  @relation(fields: [userId], references: [id], map: "buzzy_pages_discussion_insights_user_id_fkey")

  @@unique([groupId, userId])
  @@map("discussion_insights")
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String   @map("reporter_id")
  targetType  String   @map("target_type") @db.VarChar(20)
  targetId    String   @map("target_id")
  reason      String   @db.VarChar(200)
  status      String   @default("pending") @db.VarChar(20)
  aiResult    String?  @map("ai_result") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  reporter User @relation(fields: [reporterId], references: [id], map: "buzzy_pages_reports_reporter_id_fkey")

  @@map("reports")
}
